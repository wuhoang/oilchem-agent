APP_NAME=OilChem Agent
APP_VERSION=1.2.0

ENV=dev
DEBUG=true

HOST=0.0.0.0
PORT=8000

# ---- LLM 配置 ----
# 当前使用的提供商类型：
#   openai = OpenAI 兼容接口（含 DeepSeek / 通义 / OpenAI 官方等，配合 OPENAI_BASE_URL 指向具体服务商）
#   ollama = 本地 Ollama（配合本地模型如 qwen2.5）
# 切换方法：改 LLM_PROVIDER + 对应地址/模型即可，无需改代码

# 示例 A：DeepSeek（当前默认）
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-deepseek-api-key
MODEL_NAME=deepseek-chat

# 示例 B：本地 Ollama（无需 API Key，需先安装 Ollama 并拉取模型）
# LLM_PROVIDER=ollama
# OPENAI_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=
# MODEL_NAME=qwen2.5

LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ---- File System ----
FILE_ALLOWED_PATHS=
FILE_WATCH_PATHS=
FILE_DEBOUNCE_MS=2000

# ---- Database ----
DATABASE_URL=sqlite+aiosqlite:///./oilchem_agent.db
DB_ECHO=false

# ---- Auth ----
AUTH_ENABLED=false
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=60

LOG_LEVEL=INFO
